{
  "manifest_version": 3,
  "name": "SoundSmith Audio Studio",
  "version": "2.0.0",
  "description": "Audiophile Web Audio DSP Engine with Material You interface, multimodal EQ, convolver, tube modelling, and LiveProg scripting.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "sidePanel",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SoundSmith Audio Studio",
    "default_popup": "ui/index.html",
    "default_icon": {
      "16": "ui/assets/icons/icon16.png",
      "48": "ui/assets/icons/icon48.png",
      "128": "ui/assets/icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "ui/index.html"
  },
  "icons": {
    "16": "ui/assets/icons/icon16.png",
    "48": "ui/assets/icons/icon48.png",
    "128": "ui/assets/icons/icon128.png"
  }
}
